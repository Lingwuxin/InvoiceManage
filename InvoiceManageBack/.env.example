# Copy this file to .env and replace the placeholder values.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DB_NAME=invoice_manage
DB_USER=invoice_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: on-demand invoice verification with an OpenAI-compatible vision model.
# Leave the key and model empty to disable vision verification.
VISION_MODEL_API_KEY=
VISION_MODEL_NAME=
VISION_MODEL_BASE_URL=https://api.openai.com/v1
VISION_MODEL_TIMEOUT=90
